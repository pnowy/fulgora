{
  "name": "Fulgora Light (Sunset)",
  "type": "light",
  // Light counterpart of Fulgora Dark (Sunset): lavender-white window, the Sunset magenta accent, Sunset Drive terminal hues darkened for a light background, and the Fulgora Light (Soft) syntax colors.
  "semanticHighlighting": true,
  "colors": {
    "editor.background": "#F8F7FC",
    "editor.foreground": "#2A2540",
    "editorCursor.foreground": "#2A2540",
    "editor.selectionBackground": "#DCD6F0",
    "editor.inactiveSelectionBackground": "#DCD6F099",
    "editor.selectionHighlightBackground": "#DCD6F080",
    "editor.wordHighlightBackground": "#DCD6F080",
    "editor.wordHighlightStrongBackground": "#EBC9EE80",
    "editor.findMatchBackground": "#F5C2E3",
    "editor.findMatchHighlightBackground": "#DCD6F0CC",
    "editor.lineHighlightBackground": "#F0EDF7",
    "editorBracketMatch.border": "#0AA377",
    "editorBracketMatch.background": "#00000000",
    "editorIndentGuide.background1": "#E6E2EE",
    "editorIndentGuide.activeBackground1": "#B5B0C8",
    "editorWhitespace.foreground": "#DCD7E8",
    "editorRuler.foreground": "#DCD7E8",
    "editorGutter.background": "#F8F7FC",
    "editorGutter.addedBackground": "#2EA043",
    "editorGutter.modifiedBackground": "#2E78C2",
    "editorGutter.deletedBackground": "#A09CB5",
    "editorLineNumber.foreground": "#8E8AA6",
    "editorLineNumber.activeForeground": "#4A4566",
    "editorBracketHighlight.foreground1": "#2A2540",
    "editorBracketHighlight.foreground2": "#2A2540",
    "editorBracketHighlight.foreground3": "#2A2540",
    "editorBracketHighlight.foreground4": "#2A2540",
    "editorBracketHighlight.foreground5": "#2A2540",
    "editorBracketHighlight.foreground6": "#2A2540",
    "editorBracketHighlight.unexpectedBracket.foreground": "#E20157",
    "titleBar.activeBackground": "#EEEBF5",
    "titleBar.inactiveBackground": "#EEEBF5",
    "titleBar.activeForeground": "#2A2540",
    "titleBar.inactiveForeground": "#8A86A3",
    "titleBar.border": "#EEEBF5",
    "activityBar.background": "#EEEBF5",
    "activityBar.foreground": "#2A2540",
    "activityBar.inactiveForeground": "#69688B",
    "activityBar.activeBorder": "#B03AB5",
    "activityBar.border": "#EEEBF5",
    "activityBarBadge.background": "#B03AB5",
    "activityBarBadge.foreground": "#FFFFFF",
    "statusBar.background": "#EEEBF5",
    "statusBar.foreground": "#69688B",
    "statusBar.border": "#EEEBF5",
    "statusBar.noFolderBackground": "#EEEBF5",
    "sideBar.background": "#F8F7FC",
    "sideBar.foreground": "#2A2540",
    "sideBar.border": "#EEEBF5",
    "sideBarSectionHeader.background": "#F8F7FC",
    "sideBarSectionHeader.border": "#EEEBF5",
    "panel.background": "#F8F7FC",
    "panel.border": "#EEEBF5",
    "panelTitle.activeBorder": "#B03AB5",
    "panelTitle.activeForeground": "#2A2540",
    "panelTitle.inactiveForeground": "#69688B",
    "list.activeSelectionBackground": "#EBDDF2",
    "list.activeSelectionForeground": "#2A2540",
    "list.inactiveSelectionBackground": "#F2EFF8",
    "list.hoverBackground": "#2A254010",
    "list.highlightForeground": "#A73FA8",
    "tree.indentGuidesStroke": "#00000000",
    "tree.inactiveIndentGuidesStroke": "#00000000",
    "editorGroupHeader.tabsBackground": "#F8F7FC",
    "editorGroupHeader.tabsBorder": "#EEEBF5",
    "editorGroup.border": "#EEEBF5",
    "tab.border": "#F8F7FC",
    "tab.activeBackground": "#F1E9F7",
    "tab.activeForeground": "#2A2540",
    "tab.activeBorder": "#C9A3D6",
    "tab.inactiveBackground": "#F8F7FC",
    "tab.inactiveForeground": "#69688B",
    "tab.unfocusedActiveBackground": "#EEEBF5",
    "tab.unfocusedActiveBorder": "#D8D3E4",
    "tab.hoverBackground": "#2A254010",
    "editorWidget.background": "#EEEBF5",
    "editorWidget.border": "#DCD7E8",
    "quickInput.background": "#EEEBF5",
    "menu.background": "#EEEBF5",
    "menu.border": "#DCD7E8",
    "menu.selectionBackground": "#EBDDF2",
    "editorSuggestWidget.background": "#F2EFF8",
    "editorSuggestWidget.border": "#DCD7E8",
    "editorSuggestWidget.foreground": "#2A2540",
    "editorSuggestWidget.highlightForeground": "#A73FA8",
    "editorSuggestWidget.selectedBackground": "#EBDDF2",
    "editorHoverWidget.background": "#F2EFF8",
    "editorHoverWidget.border": "#DCD7E8",
    "focusBorder": "#B03AB5",
    "progressBar.background": "#B03AB5",
    "badge.background": "#B03AB5",
    "badge.foreground": "#FFFFFF",
    "button.background": "#B03AB5",
    "button.foreground": "#FFFFFF",
    "input.background": "#F8F7FC",
    "input.border": "#CFCADC",
    "dropdown.background": "#EEEBF5",
    "dropdown.border": "#CFCADC",
    "textLink.foreground": "#1666AA",
    "multiDiffEditor.headerBackground": "#F8F7FC",
    "multiDiffEditor.border": "#EEEBF5",
    "terminal.background": "#F8F7FC",
    "terminal.foreground": "#2A2540",
    "diffEditor.insertedLineBackground": "#E1F0E1CC",
    "diffEditor.insertedTextBackground": "#AAC4AFB3",
    "diffEditor.removedLineBackground": "#E6E6E6CC",
    "diffEditor.removedTextBackground": "#B9BCBFB3",
    "diffEditorGutter.insertedLineBackground": "#E1F0E1CC",
    "diffEditorGutter.removedLineBackground": "#E6E6E6CC",
    "diffEditorOverview.insertedForeground": "#447152",
    "diffEditorOverview.removedForeground": "#656E76",
    "diffEditor.diagonalFill": "#ECECE8",
    "diffEditor.unchangedRegionBackground": "#F7F7F5",
    "diffEditor.unchangedRegionForeground": "#5F6269",
    "diffEditor.move.border": "#43698D",
    "diffEditor.moveActive.border": "#43698D",
    "merge.currentHeaderBackground": "#A7B9CDB3",
    "merge.currentContentBackground": "#DDE4F0CC",
    "merge.incomingHeaderBackground": "#AAC4AFB3",
    "merge.incomingContentBackground": "#E1F0E1CC",
    "merge.commonHeaderBackground": "#B9BCBFB3",
    "merge.commonContentBackground": "#E6E6E6CC",
    "mergeEditor.change.background": "#DDE4F0CC",
    "mergeEditor.change.word.background": "#A7B9CDB3",
    "mergeEditor.conflict.unhandledUnfocused.border": "#8F5247",
    "mergeEditor.conflict.unhandledFocused.border": "#8F5247",
    "editorOverviewRuler.currentContentForeground": "#43698D",
    "editorOverviewRuler.incomingContentForeground": "#447152",
    "terminal.ansiBlack": "#1F1B2E",
    "terminal.ansiRed": "#C8014C",
    "terminal.ansiGreen": "#057441",
    "terminal.ansiYellow": "#706500",
    "terminal.ansiBlue": "#0669A6",
    "terminal.ansiMagenta": "#B207B2",
    "terminal.ansiCyan": "#057169",
    "terminal.ansiWhite": "#8A86A3",
    "terminal.ansiBrightBlack": "#6A6688",
    "terminal.ansiBrightRed": "#B7534D",
    "terminal.ansiBrightGreen": "#0E825F",
    "terminal.ansiBrightYellow": "#777605",
    "terminal.ansiBrightBlue": "#0D74CA",
    "terminal.ansiBrightMagenta": "#AF48B0",
    "terminal.ansiBrightCyan": "#0E7F80",
    "terminal.ansiBrightWhite": "#A8A4BC"
  },
  // Each scope entry is an independent selector: never list parent scopes such as source.ts here.
  "tokenColors": [
    // GENERAL
    // Fallbacks shared by every language; values come from the DEFAULT_* attributes of fulgora.icls
    {
      "name": "Comments",
      "scope": [
        "comment",
        "comment.block.documentation",
        "punctuation.definition.comment"
      ],
      "settings": {
        "foreground": "#6E717A"
      }
    },
    {
      "name": "Doc comment tags",
      "scope": [
        "keyword.other.documentation",
        "storage.type.class.jsdoc",
        "storage.type.class.javadoc",
        "entity.name.type.instance.jsdoc"
      ],
      "settings": {
        "foreground": "#6E717A",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Keywords",
      "scope": [
        "keyword",
        "keyword.control",
        "storage",
        "storage.type",
        "storage.modifier",
        "keyword.operator.new",
        "keyword.operator.expression",
        "constant.language",
        "variable.language",
        "markup.heading"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "Operators",
      "scope": [
        "keyword.operator",
        "punctuation.separator.key-value"
      ],
      "settings": {
        "foreground": "#55585E"
      }
    },
    {
      "name": "Commas and semicolons",
      "scope": [
        "punctuation.separator.comma",
        "punctuation.separator.delimiter",
        "punctuation.separator.parameter",
        "punctuation.separator.parameters",
        "punctuation.separator.dictionary.pair",
        "punctuation.separator.array",
        "punctuation.separator.arguments",
        "punctuation.separator.element",
        "punctuation.terminator"
      ],
      "settings": {
        "foreground": "#AD4E37"
      }
    },
    {
      "name": "Strings",
      "scope": [
        "string",
        "string.template",
        "punctuation.definition.string"
      ],
      "settings": {
        "foreground": "#367B30"
      }
    },
    {
      "name": "String escapes",
      "scope": [
        "constant.character.escape"
      ],
      "settings": {
        "foreground": "#3F6375",
        "fontStyle": "bold"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp",
        "punctuation.definition.group.regexp",
        "punctuation.definition.character-class.regexp"
      ],
      "settings": {
        "foreground": "#655401"
      }
    },
    {
      "name": "Template interpolation delimiters",
      "scope": [
        "punctuation.definition.template-expression.begin",
        "punctuation.definition.template-expression.end"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "Template interpolation body",
      "scope": [
        "meta.template.expression"
      ],
      "settings": {
        "foreground": "#2B2C30"
      }
    },
    {
      "name": "Numbers",
      "scope": [
        "constant.numeric",
        "keyword.other.unit"
      ],
      "settings": {
        "foreground": "#08798D"
      }
    },
    {
      "name": "Constants",
      "scope": [
        "constant.other",
        "constant.character"
      ],
      "settings": {
        "foreground": "#984742"
      }
    },
    {
      "name": "Enum constants",
      "scope": [
        "constant.other.enum",
        "variable.other.enummember"
      ],
      "settings": {
        "foreground": "#055F5D"
      }
    },
    {
      "name": "Classes and types",
      "scope": [
        "entity.name.type",
        "entity.name.class",
        "entity.other.inherited-class",
        "support.class",
        "support.type"
      ],
      "settings": {
        "foreground": "#376048"
      }
    },
    {
      "name": "Interfaces",
      "scope": [
        "entity.name.type.interface"
      ],
      "settings": {
        "foreground": "#466702"
      }
    },
    {
      "name": "Type parameters",
      "scope": [
        "entity.name.type.parameter",
        "variable.other.generic-type"
      ],
      "settings": {
        "foreground": "#3A5875"
      }
    },
    {
      "name": "Primitive types",
      "scope": [
        "support.type.primitive",
        "storage.type.primitive"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function"
      ],
      "settings": {
        "foreground": "#755900"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "support.function",
        "meta.function-call entity.name.function",
        "variable.function"
      ],
      "settings": {
        "foreground": "#655401"
      }
    },
    {
      "name": "Fields and properties",
      "scope": [
        "variable.other.property",
        "variable.other.object.property",
        "variable.object.property",
        "support.variable.property",
        "meta.object-literal.key",
        "entity.other.attribute-name",
        "support.type.property-name"
      ],
      "settings": {
        "foreground": "#565486"
      }
    },
    {
      "name": "Annotations and decorators",
      "scope": [
        "storage.type.annotation",
        "meta.declaration.annotation",
        "meta.decorator",
        "entity.name.function.decorator",
        "punctuation.definition.decorator",
        "punctuation.decorator"
      ],
      "settings": {
        "foreground": "#7B52A4"
      }
    },
    {
      "name": "Parameters and locals",
      "scope": [
        "variable.parameter"
      ],
      "settings": {
        "foreground": "#554E25"
      }
    },
    // TOKENS
    // Log file severity markers
    {
      "name": "Info",
      "scope": [
        "token.info-token"
      ],
      "settings": {
        "foreground": "#2A669F"
      }
    },
    {
      "name": "Warning",
      "scope": [
        "token.warn-token"
      ],
      "settings": {
        "foreground": "#815B04"
      }
    },
    {
      "name": "Error",
      "scope": [
        "token.error-token"
      ],
      "settings": {
        "foreground": "#A43B38"
      }
    },
    {
      "name": "Debug",
      "scope": [
        "token.debug-token"
      ],
      "settings": {
        "foreground": "#725195"
      }
    },
    // JAVA
    // Matches the JAVA section of fulgora.icls
    {
      "name": "Types",
      "scope": [
        "storage.type.java",
        "storage.type.generic.java",
        "storage.type.object.array.java",
        "entity.name.type.class.java",
        "entity.name.type.enum.java",
        "meta.definition.class.inherited.classes.java entity.other.inherited-class.java"
      ],
      "settings": {
        "foreground": "#376048"
      }
    },
    {
      "name": "Implemented interfaces",
      "scope": [
        "meta.definition.class.implemented.interfaces.java entity.other.inherited-class.java",
        "entity.name.type.interface.java"
      ],
      "settings": {
        "foreground": "#466702"
      }
    },
    {
      "name": "Primitive types",
      "scope": [
        "storage.type.primitive.java",
        "storage.type.primitive.array.java"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "Package names",
      "scope": [
        "storage.modifier.package.java"
      ],
      "settings": {
        "foreground": "#2B2C30"
      }
    },
    {
      "name": "Imports",
      "scope": [
        "storage.modifier.import.java"
      ],
      "settings": {
        "foreground": "#376048"
      }
    },
    {
      "name": "Fields, variables and parameters",
      "scope": [
        "variable.other.definition.java",
        "variable.parameter.java",
        "variable.other.object.java",
        "variable.other.object.property.java",
        "variable.other.property.java"
      ],
      "settings": {
        "foreground": "#026A9D"
      }
    },
    {
      "name": "Methods",
      "scope": [
        "entity.name.function.java"
      ],
      "settings": {
        "foreground": "#2B2C30"
      }
    },
    {
      "name": "Enum constants",
      "scope": [
        "constant.other.enum.java"
      ],
      "settings": {
        "foreground": "#055F5D"
      }
    },
    // JAVASCRIPT AND TYPESCRIPT
    // Matches the JS.* attributes of fulgora.icls
    {
      "name": "Locals and parameters",
      "scope": [
        "variable.other.readwrite.ts",
        "variable.other.readwrite.tsx",
        "variable.other.readwrite.js",
        "variable.other.constant.ts",
        "variable.other.constant.tsx",
        "variable.other.constant.js",
        "variable.parameter.ts",
        "variable.parameter.tsx",
        "variable.parameter.js",
        "variable.other.object.ts",
        "variable.other.object.tsx",
        "variable.other.object.js"
      ],
      "settings": {
        "foreground": "#026A9D"
      }
    },
    {
      "name": "Import aliases",
      "scope": [
        "variable.other.readwrite.alias.ts",
        "variable.other.readwrite.alias.tsx",
        "variable.other.readwrite.alias.js"
      ],
      "settings": {
        "foreground": "#376048"
      }
    },
    {
      "name": "Method declarations",
      "scope": [
        "meta.definition.method entity.name.function"
      ],
      "settings": {
        "foreground": "#026A9D"
      }
    },
    {
      "name": "Regular expressions",
      "scope": [
        "string.regexp.ts",
        "string.regexp.tsx",
        "string.regexp.js"
      ],
      "settings": {
        "foreground": "#655401"
      }
    },
    // PYTHON
    // Matches the PY.* attributes of fulgora.icls
    {
      "name": "Strings",
      "scope": [
        "source.python string"
      ],
      "settings": {
        "foreground": "#376932"
      }
    },
    {
      "name": "Docstrings",
      "scope": [
        "source.python string.quoted.docstring"
      ],
      "settings": {
        "foreground": "#6E717A"
      }
    },
    {
      "name": "Function calls",
      "scope": [
        "meta.function-call.generic.python"
      ],
      "settings": {
        "foreground": "#655401"
      }
    },
    {
      "name": "Builtins",
      "scope": [
        "support.function.builtin.python",
        "support.type.python"
      ],
      "settings": {
        "foreground": "#984B16"
      }
    },
    {
      "name": "Self parameter",
      "scope": [
        "variable.parameter.function.language.special.self.python",
        "variable.language.special.self.python"
      ],
      "settings": {
        "foreground": "#655401"
      }
    },
    {
      "name": "Keyword arguments",
      "scope": [
        "variable.parameter.function-call.python"
      ],
      "settings": {
        "foreground": "#2B2C30"
      }
    },
    {
      "name": "Logical operators",
      "scope": [
        "keyword.operator.logical.python"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    // YAML
    // YAML has no numeric token in IntelliJ, so plain scalars stay white
    {
      "name": "Keys",
      "scope": [
        "entity.name.tag.yaml"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "Plain values",
      "scope": [
        "string.unquoted.plain.out.yaml",
        "source.yaml constant.numeric",
        "constant.language.boolean.yaml",
        "constant.language.null.yaml",
        "constant.language.yaml"
      ],
      "settings": {
        "foreground": "#2B2C30"
      }
    },
    {
      "name": "Separators",
      "scope": [
        "punctuation.separator.map.value.yaml",
        "punctuation.definition.block.sequence.item.yaml"
      ],
      "settings": {
        "foreground": "#2B2C30"
      }
    },
    {
      "name": "Anchors",
      "scope": [
        "keyword.control.flow.anchor.yaml",
        "punctuation.definition.anchor.yaml",
        "variable.other.anchor.yaml",
        "variable.other.alias.yaml",
        "keyword.control.flow.alias.yaml"
      ],
      "settings": {
        "foreground": "#3464A0"
      }
    },
    // TERRAFORM AND HCL
    // The scheme defines no HCL colors, so these keep the theme palette
    {
      "name": "Block types",
      "scope": [
        "entity.name.type.hcl",
        "entity.name.type.terraform"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "Block labels",
      "scope": [
        "variable.other.enummember.hcl"
      ],
      "settings": {
        "foreground": "#466702"
      }
    },
    {
      "name": "Attributes and references",
      "scope": [
        "variable.other.readwrite.hcl",
        "variable.other.readwrite.terraform",
        "variable.declaration.hcl"
      ],
      "settings": {
        "foreground": "#565486"
      }
    },
    // SHELL
    // Matches the BASH.* attributes of fulgora.icls
    {
      "name": "Builtin commands",
      "scope": [
        "support.function.builtin.shell"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "External commands",
      "scope": [
        "entity.name.command.shell"
      ],
      "settings": {
        "foreground": "#AD4E37"
      }
    },
    {
      "name": "Function declarations",
      "scope": [
        "entity.name.function.shell"
      ],
      "settings": {
        "foreground": "#026A9D",
        "fontStyle": "bold"
      }
    },
    // HTML AND MARKUP
    // Tags, attributes and Markdown
    {
      "name": "Tags",
      "scope": [
        "entity.name.tag",
        "punctuation.definition.tag"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "Markdown lists",
      "scope": [
        "punctuation.definition.list.begin.markdown"
      ],
      "settings": {
        "foreground": "#9C433F"
      }
    },
    {
      "name": "Markdown code",
      "scope": [
        "markup.inline.raw",
        "markup.fenced_code.block"
      ],
      "settings": {
        "foreground": "#236682"
      }
    },
    {
      "name": "Markdown quotes",
      "scope": [
        "markup.quote"
      ],
      "settings": {
        "foreground": "#4F6778"
      }
    },
    {
      "name": "Markdown links",
      "scope": [
        "markup.underline.link",
        "string.other.link"
      ],
      "settings": {
        "foreground": "#1666AA"
      }
    },
    // CSS
    // Matches the CSS.* attributes of fulgora.icls
    {
      "name": "Selectors",
      "scope": [
        "entity.other.attribute-name.class.css",
        "entity.other.attribute-name.class.scss",
        "entity.other.attribute-name.id",
        "entity.other.attribute-name.pseudo-class.css",
        "entity.other.attribute-name.pseudo-element.css"
      ],
      "settings": {
        "foreground": "#985100"
      }
    },
    {
      "name": "Property values",
      "scope": [
        "support.constant.property-value.css",
        "support.constant.property-value.scss"
      ],
      "settings": {
        "foreground": "#2B2C30"
      }
    },
    {
      "name": "Value functions",
      "scope": [
        "support.function.misc.css",
        "support.function.misc.scss"
      ],
      "settings": {
        "foreground": "#3A5875",
        "fontStyle": "bold"
      }
    },
    {
      "name": "URLs and important",
      "scope": [
